# Copy this to .env and fill in your values
DATABASE_URL=postgresql://postgres:password@localhost:5432/purohitseva
SECRET_KEY=change-me-to-a-long-random-string-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Razorpay — get from https://dashboard.razorpay.com > Settings > API Keys
# Use TEST mode keys during development (prefix rzp_test_)
RAZORPAY_KEY_ID=rzp_test_XXXXXXXXXXXXXXXX
RAZORPAY_KEY_SECRET=XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Razorpay webhook secret — set this after creating a webhook in the dashboard
# Dashboard > Settings > Webhooks > Secret
RAZORPAY_WEBHOOK_SECRET=XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
